{
  "$meta": {
    "source": "https://sanctuaryonthemoon.com/",
    "extractedAt": "2026-07-27",
    "note": "Nuxt SSR + WebGL/滚轮驱动场景。颜色/字体为实测值；动效时长部分为推断值（inferred: true）。"
  },
  "color": {
    "brand": {
      "primary": "#EA6D15",
      "primaryName": "copper 古铜橙（唯一强调色：按钮描边、数字高亮、星光点缀、hover 态）",
      "secondary": "#0B1533",
      "secondaryName": "darkblue 深空蓝（section 底色）"
    },
    "surface": {
      "background": "#080E21",
      "backgroundAlt": "#0B1533",
      "black": "#000000",
      "overlay": "rgba(8, 14, 33, 0.5)"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "rgba(255, 255, 255, 0.7)",
      "muted": "rgba(255, 255, 255, 0.5)",
      "onAccent": "#FFFFFF"
    },
    "border": {
      "default": "rgba(255, 255, 255, 0.15)",
      "subtle": "rgba(255, 255, 255, 0.10)",
      "accent": "#EA6D15"
    },
    "state": {
      "hover": "#EA6D15",
      "focus": "#EA6D15"
    }
  },
  "typography": {
    "fontFamily": {
      "base": "\"Jost\", \"Outfit\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "heading": "\"Jost\", \"Outfit\", \"PingFang SC\", sans-serif",
      "mono": "\"Geist Mono\", monospace",
      "_original": "Rustica, Arial, sans-serif（商业几何无衬线，类 Futura；免费替代：Jost 最接近，其次 Outfit/Montserrat）"
    },
    "fontSize": {
      "xs": "11px",
      "sm": "13px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "36px",
      "3xl": "48px",
      "mega": "clamp(3rem, 8vw, 9rem)"
    },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.1, "normal": 1.5, "relaxed": 1.7 },
    "letterSpacing": {
      "label": "0.2em",
      "logo": "0.4rem",
      "megaTitle": "0.02em",
      "body": "0"
    }
  },
  "spacing": {
    "base": "8px",
    "xs": "8px", "sm": "16px", "md": "24px", "lg": "48px", "xl": "96px", "2xl": "160px",
    "sectionGap": "20vh（场景之间大量留白，推断）"
  },
  "radius": { "sm": "4px", "md": "10px", "pill": "99px", "circle": "50%" },
  "shadow": {
    "none": "none（全站基本无阴影，靠 1px 描边与明暗对比分层）"
  },
  "motion": {
    "duration": { "fast": "0.3s", "normal": "0.5s", "slow": "1s", "ceremonial": "1.6s（推断）" },
    "easing": {
      "standard": "cubic-bezier(0.165, 0.84, 0.44, 1)",
      "standardName": "easeOutQuint — 全站绝对主力（出现 51 次）",
      "inOut": "cubic-bezier(0.455, 0.03, 0.515, 0.955)",
      "inOutName": "easeInOutQuad — 滚动场景切换",
      "dramatic": "cubic-bezier(0.77, 0, 0.175, 1)",
      "dramaticName": "easeInOutQuart — 大幅位移/变形"
    },
    "inferred": true
  },
  "opacity": { "borderSubtle": 0.1, "borderDefault": 0.15, "textMuted": 0.5, "textSecondary": 0.7 }
}
